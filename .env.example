# Django
DEBUG=False
ALLOWED_HOSTS=.vercel.app,zentanee.vercel.app,localhost,127.0.0.1
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret
# Canonical public origin. Used for canonical tags, sitemap, feeds, Telegram
# links and SMS/email links — set it to the custom domain once it exists.
SITE_URL=https://your-production-domain.example

# Database (required in production)
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Shared cache (strongly recommended on Vercel: Upstash free tier). Without it
# fragment/menu caches and login rate limits are per-lambda only.
REDIS_URL=

# Cloudinary (optional; required only if using cloud media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Store identity (footer, policy pages, schema.org) ─────────────────────────
STORE_NAME=Zentanee
STORE_LEGAL_NAME=
STORE_PHONE=+251933392463
STORE_EMAIL=
STORE_ADDRESS=Addis Ababa, Ethiopia
STORE_TRADE_LICENSE=
STORE_TIN=
STORE_INSTAGRAM_URL=https://instagram.com/zentanee
STORE_SUPPORT_HOURS=Monday to Saturday, 9:00 to 18:00

# Stock messaging: false = "In stock / Sold out" language (order-on-demand),
# true = show unit counts ("Only 2 left"). DEFAULT_STOCK_PER_SIZE is the count
# a brand-new size starts with; 0 forces staff to enter real counts.
STORE_SHOW_STOCK_COUNTS=false
DEFAULT_STOCK_PER_SIZE=10

# Analytics (GA4). Empty disables the snippet.
GA_MEASUREMENT_ID=G-PMSGT50Q4W

# Coupon auto-applied to carts that arrived through an affiliate /ref/ link.
REFERRAL_WELCOME_COUPON_CODE=

# ── Email (password reset, order receipts, restock alerts) ────────────────────
# Any SMTP provider (Resend, Postmark, Brevo, SES). Leave EMAIL_HOST empty to
# keep the console backend — production then WARNS at startup.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# ── SMS (order confirmation + dispatch notice) ────────────────────────────────
# disabled | console | afromessage | http
SMS_BACKEND=disabled
SMS_SENDER_ID=Zentanee
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
# Generic JSON gateway alternative: {to} {message} {sender} are substituted.
SMS_HTTP_URL=
SMS_HTTP_HEADERS={"Authorization": "Bearer YOUR_TOKEN"}
SMS_HTTP_BODY={"to": "{to}", "message": "{message}", "from": "{sender}"}
SMS_STATUS_NOTIFY_STATUSES=On The Way

# ── Online payment via Chapa (Telebirr, CBE Birr, cards). Empty = COD only. ──
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# Defaults are on when DEBUG is off. Set SECURE_HSTS_SECONDS when self-hosting
# (Vercel already sends HSTS). CSP_REPORT_ONLY=true to trial policy changes.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=0
CSP_REPORT_ONLY=false
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Gemini product enrichment (optional; required for AI draft generation)
GEMINI_API_KEY=
GEMINI_PRODUCT_MODEL=gemini-2.5-flash
GEMINI_PRODUCT_FALLBACK_MODEL=gemini-2.5-flash-lite
AI_IMAGE_GENERATOR_ENDPOINT=
AI_IMAGE_GENERATOR_TOKEN=
AI_IMAGE_GENERATOR_TIMEOUT=300
AI_IMAGE_GENERATOR_RETRIES=2
AI_IMAGE_GENERATOR_SHOTS_PER_REQUEST=1
AI_IMAGE_GENERATOR_FALLBACK_TO_LOCAL=False
AI_AUTO_CREATE_COLLECTIONS=True
AI_AUTO_CREATE_BRANDS=True

# Store-wide policy copy (per-product overrides still win)
STORE_DELIVERY_NOTE=
STORE_RETURN_NOTE=

# Shared secret for the /internal/run-tasks/ drain endpoint. Must match the
# RUN_TASKS_SECRET GitHub Actions secret used by .github/workflows/run-tasks.yml.
RUN_TASKS_SECRET=

# Telegram admin-alert bot (signup/order notifications to owner)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ADMIN_WEBHOOK_SECRET=

# Telegram customer bot (channel + order flow)
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_CUSTOMER_CHANNEL_CHAT_ID=@zentanee_channel
TELEGRAM_CUSTOMER_BOT_USERNAME=
TELEGRAM_CUSTOMER_WEBHOOK_SECRET=
